{
  "name": "senna-bot",
  "version": "2.0.2",
  "description": "Modular WhatsApp Bot — run anywhere with npx senna-bot init",
  "main": "index.js",
  "type": "module",
  "bin": {
    "senna-bot": "bin/senna.js",
    "senna": "bin/senna.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "lib/",
    "plugins/",
    "src/",
    "config.js",
    "handler.js",
    "index.js",
    "main.js",
    "pair.js"
  ],
  "author": {
    "name": "Gumball",
    "url": "https://github.com/Gumballxnz"
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Gumballxnz/senna-bot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gumballxnz/senna-bot.git"
  },
  "bugs": {
    "url": "https://github.com/Gumballxnz/senna-bot/issues"
  },
  "directories": {
    "lib": "lib",
    "src": "src",
    "plugins": "plugins"
  },
  "scripts": {
    "start": "node --no-deprecation --max-old-space-size=512 index.js",
    "dev": "nodemon index.js",
    "publish:all": "node scripts/publish.js"
  },
  "keywords": [
    "baileys-md",
    "dylux-bot",
    "js-whatsapp",
    "multi-device",
    "npx",
    "senna",
    "senna-bot",
    "termux-whatsapp-bot",
    "whatsapp-bot",
    "whatsapp-bot-cli"
  ],
  "dependencies": {
    "@hapi/boom": "^9.1.4",
    "@vitalets/google-translate-api": "^9.2.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "archiver": "^7.0.1",
    "awesome-phonenumber": "^3.4.0",
    "axios": "^1.1.2",
    "cfonts": "^3.1.1",
    "chalk": "^5.6.2",
    "cheerio": "^1.0.0-rc.12",
    "chokidar": "^5.0.0",
    "express": "^4.18.1",
    "fg-senna": "^0.0.9",
    "file-type": "^18.0.0",
    "fluent-ffmpeg": "^2.1.2",
    "formdata-node": "^5.0.0",
    "jsdom": "^20.0.1",
    "lodash": "^4.17.21",
    "lowdb": "^3.0.0",
    "megajs": "^1.1.3",
    "moment-timezone": "^0.5.46",
    "mongoose": "^6.6.5",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.2.10",
    "node-gtts": "^2.0.2",
    "performance-now": "^2.1.0",
    "pino": "^8.6.1",
    "qrcode": "^1.5.1",
    "sharp": "^0.33.2",
    "syntax-error": "^1.4.0",
    "url-regex-safe": "^3.0.0",
    "yargs": "^17.6.0",
    "yt-search": "^2.13.1"
  },
  "optionalDependencies": {
    "wa-sticker-formatter": "^4.3.2"
  }
}
